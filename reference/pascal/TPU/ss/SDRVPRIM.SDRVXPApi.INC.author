procedure SdrvInterfaceInit;
var
  r: TRegistry;
  dll_path: AnsiString;
begin
  SDrvInMemory:=False;
  r:=TRegistry.Create(KEY_READ);
  try
    r.RootKey:=HKEY_LOCAL_MACHINE;
    r.OpenKeyReadOnly(REGSTR_SDRV);

    dll_path:=r.ReadString(REGSTR_SDRVXP_API_LIBRARY_KEY);
    if not FileExists(dll_path) then
      Exit;

    SdrvXPApi_Module:=LoadLibrary(PAnsiChar(dll_path));
    if SdrvXPApi_Module = 0 then
      Exit;

    SDRVXPApi_Invoke:=TSDRVXPApiInvoke(GetProcAddress(SdrvXPApi_Module, SDRVXP_API_INVOKE_NAME));
    if Addr(SDRVXPApi_Invoke) = nil then
      Exit;

    SDrvInMemory:=True;
    SdrvInt:=$80;

    SpkParam.Voice:=Male1;
    SpkParam.Tempo:=30;
    SpkParam.Volume:=255;
    SpkParam.Output:=0;
    SpkParam.Pitch:=nil;
    SpkParam.KeyBreak:=nil;
    
    Invoke(APC_QUERY_DllInit);

  finally
    FreeAndNil(r); 
  end;
end;

procedure SdrvInterfaceDone;
begin
  if Addr(SDRVXPApi_Invoke) = nil then
    Exit;
  Invoke(APC_QUERY_DllDone);
  SDRVXPApi_Invoke:=nil;
  if SdrvXPApi_Module = 0 then
    Exit;
  FreeLibrary(SdrvXPApi_Module);
  SdrvXPApi_Module:=0;
end;

