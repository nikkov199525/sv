var
  SdrvXPApi_Module: HMODULE;
  SDRVXPApi_Invoke: TSDRVXPApiInvoke;
  Query: VDXD_APC_QUERY;
  SpkParam: TSpkParam;

procedure Invoke(FUNC: DWORD);
begin
  Query.FUNC:=FUNC;
  Query.DONE:=0;
  SDRVXPApi_Invoke(@Query);
end;

function SDrvResult:word;
begin
  SDrvResult:=0;
end;

procedure SText00(stSent: String);
var
  pq: lpVDXD_APC_QUERY_TTS;
  is_ctrl_breaking: Boolean;
  is_ctrl_pressed: Boolean;
  i: Integer;
begin
  if not SDrvInMemory then 
    Exit;
  if Length(stSent) = 0 then 
    Exit;
  is_ctrl_pressed:=(GetKeyEventShiftState(PollShiftStateEvent) and kbCtrl) <> 0;

  { нужно выделять немного больше, т.к. портится память после конца строки }
  pq:=GetMem(SizeOf(VDXD_APC_QUERY_TTS) + Length(stSent) + 100);
  if pq = nil then
    Exit;

  Invoke(APC_QUERY_BeginPlay);
  try
    pq^.FUNC:=APC_QUERY_PlayBlock;
    pq^.DONE:=0;
    pq^.Dictor:=Ord(SpkParam.Voice);
    pq^.Tempo:=SpkParam.Tempo;
    pq^.Volume:=SpkParam.Volume;
    pq^.ALen:=SizeOf(pq^.Reserved3) + Length(stSent);
    FillChar(pq^.Reserved3, SizeOf(pq^.Reserved3), ' ');
    Move(stSent[1], pq^.AText, Length(stSent));

    SDRVXPApi_Invoke(PVDXD_APC_QUERY(pq));
    is_ctrl_breaking:=False;
    while True do begin
      Invoke(APC_QUERY_IsPlaying);
      if Query.DONE = 1 then
        break;
      if (PollKeyEvent <> 0) then begin
        Invoke(APC_QUERY_StopPlay);
        break;
      end;
      
      if is_ctrl_pressed and ((GetKeyEventShiftState(PollShiftStateEvent) and kbCtrl) = 0) then begin
        is_ctrl_pressed:=False;
      end;
      if not is_ctrl_pressed and ((GetKeyEventShiftState(PollShiftStateEvent) and kbCtrl) <> 0) then begin
        Invoke(APC_QUERY_StopPlay);
        is_ctrl_breaking:=True;
        break;
      end;
      Sleep(1);
    end;

    Invoke(APC_QUERY_EndPlay);

  finally
    FreeMem(pq);
  end;
end;

