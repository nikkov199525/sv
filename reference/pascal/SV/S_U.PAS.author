        begin
        Sorce:= '';
        Install(V_Param^.Memory);
        if not Installed then exit;
        Topic[1 ].Elem:= '1.  Программа  "SPEAKING VIEWER"  версии '+Version;
        Topic[2 ].Elem:= '2.  Главное меню программы                   ';
