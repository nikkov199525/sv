# Исходники -- UTF-8 с концами строк LF; батники хранятся как есть: CRLF и
# кодировка консоли (866), как в bookmania.
* text=auto eol=lf
*.bat -text
# Авторские исходники на Паскале и данные программы -- байт в байт
# (vendor/ -- подмодули со своими правилами).
reference/** -text
runtime/** -text
*.ico binary
