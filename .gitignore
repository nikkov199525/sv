# Промежуточные артефакты сборки. Готовые пакеты build/<арх>/ после
# успешной сборки вычищены от всего лишнего, но в историю не входят.
/obj/
/build/x86/
/build/x64/
/build/linux-x64/
/build/linux-x86/
/build/version.h
/build/version.rc
/build/*.deb

/.vs/
*.vcxproj.user
/.vscode/
/.idea/

*.obj
*.o
*.a
*.lib
*.exp
*.ilk
*.pdb
*.res

# Конвертер fb2 для Windows (fb2_to_txt.exe и его библиотеки) -- только в
# релизных пакетах, не в истории: его лицензия неизвестна. Для сборки
# релиза он лежит здесь, сборка кладёт его в пакет.
/runtime/windows/fb2/
